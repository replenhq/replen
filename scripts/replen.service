[Unit]
Description=Replen - Next.js dashboard
After=network-online.target
Wants=network-online.target
# Give up (enter failed state) after 4 failed starts in 60s instead of
# crash-looping forever. A persistent EADDRINUSE / bad build then surfaces
# loudly via `systemctl status` rather than silently serving a stale process.
StartLimitIntervalSec=60
StartLimitBurst=4

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/replen
EnvironmentFile=/opt/replen/.env
Environment=NODE_ENV=production
Environment=PORT=3030
# Bind to loopback only. Public traffic arrives via cloudflared tunnel +
# nginx; binding to 0.0.0.0 would expose the dashboard to anyone who finds
# the origin IP if UFW rules ever drift. The `npm start` script already
# passes `-H 127.0.0.1`, but HOSTNAME is read by Next as a fallback.
Environment=HOSTNAME=127.0.0.1
# Lock the log dir + files to 0640 (ubuntu:adm). Any user with a shell on
# the box could otherwise tail the file and see auth-middleware error
# traces. Two-step: dir first (so the touch can land), then files.
ExecStartPre=+/bin/mkdir -p /var/log/replen
ExecStartPre=+/bin/chmod 0750 /var/log/replen
ExecStartPre=+/bin/chown ubuntu:adm /var/log/replen
ExecStartPre=+/usr/bin/touch /var/log/replen/web.log
ExecStartPre=+/bin/chmod 0640 /var/log/replen/web.log
ExecStartPre=+/bin/chown ubuntu:adm /var/log/replen/web.log
# Run `next` DIRECTLY rather than via `npm run start`. npm doesn't reliably
# forward SIGTERM to its child, so on stop/restart the old next-server could
# linger holding :3031, and the new instance crash-looped on EADDRINUSE. With
# next as the unit's main process, systemd's SIGTERM reaches it directly and it
# releases the port before the new one binds. Args mirror package.json "start".
ExecStart=/opt/replen/node_modules/.bin/next start -H 127.0.0.1 -p 3031
Restart=on-failure
RestartSec=5
# Belt-and-suspenders: SIGTERM the main process, then SIGKILL anything still in
# the cgroup after the timeout (stray Next workers), so the port is always free
# for the next start. TimeoutStopSec caps how long a wedged stop can hang.
KillMode=mixed
TimeoutStopSec=20
StandardOutput=append:/var/log/replen/web.log
StandardError=append:/var/log/replen/web.log

# ── Sandbox hardening ─────────────────────────────────────────────────
# These directives shrink what a code-execution compromise in Node can
# reach. They are deliberately compatible with Next.js + Node 22 + git
# subprocess for the shallow-clone path. Crucially MemoryDenyWriteExecute
# is NOT set — V8 emits RWX pages for JIT and the unit would crash on
# every page compilation.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/replen /var/log/replen
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
# AF_NETLINK / AF_PACKET / AF_RAW not needed — Node uses INET[6] + UNIX
# (cluster IPC + libuv signals). Locking this down blocks a class of
# kernel-surface exploits.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
# App binds 3030 (unprivileged); drop every capability.
CapabilityBoundingSet=
AmbientCapabilities=
# Inherited writes (logs, db updates) default to 0640.
UMask=0027

[Install]
WantedBy=multi-user.target

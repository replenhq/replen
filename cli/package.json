{
  "name": "replen",
  "version": "1.0.6",
  "description": "Make your AI coding tools smarter. One command, no API keys. Replen scouts the OSS firehose against your projects and surfaces drop-in libraries, ideas to port, and dead deps to swap — the match decision happens inside your AI tool's session on your subscription tokens. 1-3 actionable matches a month, by design.",
  "type": "module",
  "bin": {
    "replen": "dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "extras",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "replen",
    "claude-code",
    "mcp",
    "cli"
  ],
  "homepage": "https://replen.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/replenhq/replen.git",
    "directory": "cli"
  },
  "bugs": "https://github.com/replenhq/replen/issues",
  "author": "replen.dev",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "smol-toml": "^1.6.1"
  }
}

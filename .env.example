# ── Database ────────────────────────────────────────────────────────────
DIGEST_DB_PATH=./data/digest.sqlite

# ── At-rest encryption ──────────────────────────────────────────────────
# Symmetric key for AES-256-GCM encryption of user secrets (PATs, LLM keys
# stored in user_settings). Generate a fresh one with:
#   openssl rand -base64 32
ENCRYPTION_KEY=

# ── Auth ────────────────────────────────────────────────────────────────
# AUTH_MODE: 'firebase' for multi-user (signup/login flow); 'solo' for
# single-user self-hosters who skip Firebase entirely. Default: firebase.
AUTH_MODE=firebase

# Firebase Admin (only used when AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY_BASE64=

# ── LLM providers (BYO keys; users can also set their own on /settings) ──
# Two slots, provider-agnostic. Wire any vendor by pointing the base URL +
# model at it. Per-user keys on /settings override these shared fallbacks.
#
# Primary slot - used for triage + low-sensitivity reasoning.
# OpenAI-compatible /chat/completions wire format. Works with DeepSeek,
# OpenAI, Groq, Together, Fireworks, OpenRouter, local llama.cpp / ollama,
# anything that speaks the OpenAI chat API.
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_BASE_URL=https://api.deepseek.com
LLM_PRIMARY_MODEL=deepseek-v4-flash
TRIAGE_MODEL=deepseek-v4-flash
REASONING_MODEL=deepseek-v4-flash

# Sensitive slot - used for projects flagged high-sensitivity (skipped
# otherwise). Defaults to Anthropic's /v1/messages wire format; set
# LLM_SENSITIVE_WIRE_FORMAT=openai-compatible to route through
# /chat/completions instead (e.g. for a privately-hosted model).
LLM_SENSITIVE_API_KEY=
LLM_SENSITIVE_BASE_URL=https://api.anthropic.com
LLM_SENSITIVE_MODEL=claude-opus-4-7
LLM_SENSITIVE_WIRE_FORMAT=anthropic
REASONING_MODEL_HIGH=claude-opus-4-7

# Legacy aliases (DEEPSEEK_* / ANTHROPIC_*) still work if set.

# ── GitHub (fallback; per-user PAT preferred) ───────────────────────────
GITHUB_TOKEN=

# ── Fetcher sources (defaults; per-user overrides on /sources) ──────────
REDDIT_USER_AGENT=replen/0.1 (by /u/yourhandle)
REDDIT_SUBS=MachineLearning,LocalLLaMA,selfhosted,programming,opensource

# Threads via RSSHub - optional. Spin up RSSHub yourself or point at an
# instance you trust. https://docs.rsshub.app/install/
RSSHUB_BASE=http://127.0.0.1:1200
THREADS_HANDLES=

# ── Email delivery ──────────────────────────────────────────────────────
# Provider: 'resend' (recommended, 5-min setup) or 'ses' (AWS SES via SMTP).
EMAIL_PROVIDER=resend

# Resend (https://resend.com - get an API key + verify a domain)
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=you@example.com
EMAIL_FROM_NAME=replen
EMAIL_TO_ADDRESS=

# Amazon SES SMTP (only used when EMAIL_PROVIDER=ses)
SES_SMTP_HOST=email-smtp.eu-west-2.amazonaws.com
SES_SMTP_PORT=587
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=

# ── Project profiles ────────────────────────────────────────────────────
# Where the digest service finds your local project repos to build
# per-project relevance profiles. Path on the host running this service.
GITHUB_ROOT=~/projects

# ── Sync CLI ────────────────────────────────────────────────────────────
# Random string; protects the /api/sync endpoint used by the laptop sync CLI.
SYNC_TOKEN=
# /api/sync is bound to exactly one user (the laptop owner). The numeric
# `users.id` of that user. Required; other user_id params return 403 even
# with the right SYNC_TOKEN.
SYNC_USER_ID=

# ── Public base URL ─────────────────────────────────────────────────────
# Used in email links, MCP setup commands, etc. For self-host this is your
# own domain (e.g. https://digest.your-domain.com); for local dev,
# http://localhost:3030.
PUBLIC_BASE_URL=http://localhost:3030

# ── Stage 4 source-context verification (experimental, off by default) ──
# Set to "1" to enable BM25 source verification for gh-targeted candidates
# that the cheap README-only pass scores as medium/high. When on, those
# candidates are shallow-cloned, indexed, and re-scored with the top source
# excerpts injected into the prompt — catches the case where a sales-pitch
# README claims functionality the code doesn't support. Adds ~30-70s per
# verified candidate (one-time clone+index, cached against readme_sha).
# Off in prod for now: current attributions are all inferred/medium which
# the LLM already strict-biases to general-awareness, so verification has
# nothing to correct yet.
STAGE4_VERIFY_WITH_SOURCE=0
